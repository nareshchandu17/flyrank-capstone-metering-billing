{
  "name": "usage-metering-billing-engine",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:init": "node scripts/init-db.js",
    "db:reset": "docker-compose down -v && docker-compose up -d && npm run db:init",
    "test:db:start": "docker-compose -f docker-compose.test.yml up -d",
    "test:db:stop": "docker-compose -f docker-compose.test.yml down",
    "test:db:init": "docker cp schema.sql usage_metering_test_db:/tmp/schema.sql && docker exec usage_metering_test_db psql -U postgres -d usage_metering_test -f /tmp/schema.sql",
    "install:frontend": "cd frontend && npm install",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
