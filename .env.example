# ==========================================
# FLYRANK USAGE METERING & BILLING ENGINE
# Environment Configuration Template
# ==========================================

# 1. Database Connection
DATABASE_URL=postgresql://postgres:<password>@localhost:5434/usage_metering
DB_HOST=localhost
DB_PORT=5434
DB_NAME=usage_metering
DB_USER=postgres
DB_PASSWORD=

# 2. Application Base URL (Required for production Stripe checkouts & redirections)
APP_URL=http://localhost:5173

# 3. Auth0 Authentication (Required)
# Configure via Auth0 Dashboard -> Applications -> APIs
AUTH0_DOMAIN=
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=

# 4. CORS & Security
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 5. Stripe Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard?session_id={CHECKOUT_SESSION_ID}&checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/dashboard?checkout=cancelled

# 6. Server
PORT=3000
NODE_ENV=development

# 7. AI Model Providers (Optional fallback inference)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 8. Outbound Quota Alerts & Notifications (Optional)
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
RESEND_API_KEY=
