AUTH0_ISSUER_BASE_URL=https://dev-bbc8bgwu86goihpx.us.auth0.com/
AUTH0_AUDIENCE=https://api.flyrank-metering
# 3. CORS & Security
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 4. Stripe Integration (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_PRICE_FREE=price_1UdVWtRoVkcBCAcRToRRFrwd
STRIPE_PRICE_PRO=price_1UdVVfRoVkcBCAcRLmYxYT6H
