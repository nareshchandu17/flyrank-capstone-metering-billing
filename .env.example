# Database
DATABASE_URL=postgresql://postgres:password@localhost:5434/usage_metering
DB_HOST=localhost
DB_PORT=5434
DB_NAME=usage_metering
DB_USER=postgres
DB_PASSWORD=password

# Administrative Authentication
ADMIN_API_KEY=admin-secret-key-change-in-production

# Stripe (Optional - platform starts cleanly without Stripe credentials)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_PRICE_FREE=price_free_plan_id
STRIPE_PRICE_PRO=price_pro_plan_id

# Server
PORT=3000
NODE_ENV=development
